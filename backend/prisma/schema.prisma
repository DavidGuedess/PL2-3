generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Category {
  VETERINARIAN
  NURSE
  OPERATIONAL
  ADMINISTRATIVE
}

model User {
  id             Int            @id @default(autoincrement())
  employeeNumber String         @unique
  name           String
  email          String         @unique
  passwordHash   String
  contact        String?
  role           Role           @default(EMPLOYEE)
  category       Category
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  shifts             Shift[]
  attendanceRecords  AttendanceRecord[]
  weekAssignments    WeekAssignment[]
}

model ShiftType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts    Shift[]
}

model Shift {
  id          Int        @id @default(autoincrement())
  userId      Int
  shiftTypeId Int?
  date        DateTime   @db.Date
  startTime   String?
  endTime     String?
  published   Boolean    @default(false)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType   ShiftType? @relation(fields: [shiftTypeId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model WeekAssignment {
  id        Int      @id @default(autoincrement())
  userId    Int
  weekStart DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

enum AttendanceType {
  IN
  OUT
}

model AttendanceRecord {
  id        Int            @id @default(autoincrement())
  userId    Int
  type      AttendanceType
  timestamp DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

model TokenBlacklist {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

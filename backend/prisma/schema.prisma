generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum Category {
  VETERINARIAN
  NURSE
  OPERATIONAL
  ADMINISTRATIVE
}

enum AvailabilityType {
  PREFERRED
  UNAVAILABLE
}

enum ChannelType {
  GROUP
  ANNOUNCEMENT
  DM
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             Int            @id @default(autoincrement())
  employeeNumber String         @unique
  name           String
  email          String         @unique
  passwordHash   String
  contact        String?
  profilePicture String?
  role           Role           @default(EMPLOYEE)
  category       Category
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens      RefreshToken[]
  shifts             Shift[]
  attendanceRecords  AttendanceRecord[]
  weekAssignments    WeekAssignment[]
  channelsCreated    Channel[]       @relation("ChannelCreator")
  channelMembers     ChannelMember[]
  messages           Message[]
  timeOffRequests    TimeOffRequest[]
  shiftSwapRequests  ShiftSwapRequest[]
  availabilities     Availability[]
}

model ShiftType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts    Shift[]
}

model Shift {
  id          Int        @id @default(autoincrement())
  userId      Int
  shiftTypeId Int?
  date        DateTime   @db.Date
  startTime   String?
  endTime     String?
  published   Boolean    @default(false)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType   ShiftType? @relation(fields: [shiftTypeId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  requesterSwapRequests ShiftSwapRequest[] @relation("RequesterShift")
  targetSwapRequests    ShiftSwapRequest[] @relation("TargetShift")
}

model WeekAssignment {
  id        Int      @id @default(autoincrement())
  userId    Int
  weekStart DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

enum AttendanceType {
  IN
  OUT
}

model AttendanceRecord {
  id        Int            @id @default(autoincrement())
  userId    Int
  type      AttendanceType
  timestamp DateTime       @default(now())
  note      String?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

model Channel {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  isPublic    Boolean         @default(true)
  type        ChannelType     @default(GROUP)
  createdById Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation("ChannelCreator", fields: [createdById], references: [id])
  members     ChannelMember[]
  messages    Message[]
}

model ChannelMember {
  id        Int      @id @default(autoincrement())
  channelId Int
  userId    Int
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([channelId, userId])
}

model Message {
  id        Int      @id @default(autoincrement())
  channelId Int?
  userId    Int
  content   String
  createdAt DateTime @default(now())
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model TokenBlacklist {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TimeOffRequest {
  id             Int           @id @default(autoincrement())
  userId         Int
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  allDay         Boolean       @default(true)
  reason         String?
  status         RequestStatus @default(PENDING)
  approvedByName String?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
}

model ShiftSwapRequest {
  id               Int           @id @default(autoincrement())
  requesterId      Int
  requesterShiftId Int
  targetShiftId    Int
  reason           String?
  status           RequestStatus @default(PENDING)
  targetAccepted   Boolean?
  approvedByName   String?
  requester        User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  requesterShift   Shift         @relation("RequesterShift", fields: [requesterShiftId], references: [id], onDelete: Cascade)
  targetShift      Shift         @relation("TargetShift", fields: [targetShiftId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([requesterId])
}

model Availability {
  id        Int              @id @default(autoincrement())
  userId    Int
  date      DateTime         @db.Date
  type      AvailabilityType
  note      String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId])
}
